<div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
    <h2 style="color: #007bff;">Login Notification</h2>
    <p style="font-size: 16px; margin-bottom: 10px;">Hello <%= user.name %>,</p>
    <p style="font-size: 16px; margin-bottom: 10px;">Your email is <%= user.email %>.</p>
    <p style="font-size: 16px; margin-bottom: 10px;">You have successfully logged in to your account on <%= new Date().toLocaleString() %>.</p>
    <p style="font-size: 16px; margin-bottom: 10px;">If this was not you, please contact our support team immediately.</p>

</div>